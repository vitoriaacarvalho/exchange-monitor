PORT=3333

# Copy this file to `.env` and replace the placeholder with your real connection string.
# Connection string for PostgreSQL.
# Requires PostgreSQL >= 15.
DATABASE_URL="postgresql://user:password@localhost:5432/mydb"

NODE_ENV=development

# Auth — see docs/auth-plan.md
JWT_SECRET=            # openssl rand -base64 48
ACCESS_TOKEN_TTL=15m
REFRESH_TOKEN_TTL_DAYS=30

# Origin of the SPA. Credentialed CORS forbids a wildcard, so this must be explicit.
CORS_ORIGIN=http://localhost:5173

# ExchangeRate-API — free key from https://app.exchangerate-api.com/sign-up
EXCHANGE_RATE_API_KEY=

# Swagger UI at /docs. Turn off in production — it maps every endpoint.
DOCS_ENABLED=true
